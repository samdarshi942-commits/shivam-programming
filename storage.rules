rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(userId) { return request.auth != null && request.auth.uid == userId; }
    match /postImages/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if owner(userId) && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /stories/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if owner(userId) && request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
    match /reels/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if owner(userId) && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
  }
}
